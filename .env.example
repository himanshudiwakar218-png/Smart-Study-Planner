# Environment Variables Template for Smart Study Planner
# Copy this file to .env for local development with your actual PostgreSQL connection string.
# DO NOT commit .env files to Git.

# PostgreSQL Connection String (e.g. from Neon, Supabase, or Vercel Postgres)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local Server Port (Defaults to 3000 if not specified)
PORT=3000

# Environment Mode (development / production / test)
NODE_ENV=development
